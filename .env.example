NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
TESTING=false

# Service-role key (Supabase project settings > API) — required by admin
# routes and the daily SimpleFin cron sync, which run with no logged-in user.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Shared secret checked against the Authorization header Vercel Cron sends
# when it calls /api/cron/simplefin-sync. Generate any random string and set
# the same value in the Vercel project's environment variables.
CRON_SECRET=your-random-cron-secret
